# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - FRONTEND CONFIGURATION
# Master Reference Template (.env.example)
# ==============================================================================
# CRITICAL SECURITY RULE:
# Never put database passwords, private payment keys, or JWT secrets here.
# Any variable prefixed with VITE_ is bundled into public client-side JavaScript!
# ==============================================================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:5000/api/v1

# Realtime WebSocket / Socket.IO Server Endpoint
VITE_SOCKET_URL=http://localhost:5000

# Public Google OAuth Client ID (Safe to expose on client)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Public Payment Gateway Publishable Key (Only key_id, NEVER key_secret)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Application Metadata
VITE_APP_NAME="Sai International Couriers & Cargo"
VITE_APP_ENV=development

