# ==============================================================================
# SAI INTERNATIONAL COURIERS - ANDROID / CAPACITOR MOBILE CONFIGURATION
# Master Reference Template (.env.mobile.example)
# ==============================================================================
# Application Package ID: com.saicouriers.delivery
# Target: Delivery Agent Android APK / App Bundle
# ==============================================================================

# Android Emulator Networking (10.0.2.2 maps to host localhost:5000)
# For physical device over Wi-Fi, change 10.0.2.2 to development PC LAN IP (e.g. 192.168.1.50)
VITE_API_URL=http://10.0.2.2:5000/api/v1
VITE_SOCKET_URL=http://10.0.2.2:5000

# Mobile Application Metadata
VITE_APP_NAME="Sai Delivery Agent"
VITE_APP_ENV=development

# Build Command to sync native assets:
# 1. npm run build
# 2. npx cap sync android
# 3. cd android && ./gradlew assembleDebug

