# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - PRODUCTION (.env.production.example)
# Hardened configuration for live production cluster deployment.
# ==============================================================================

NODE_ENV=production
PORT=5000
APP_NAME="Sai International Couriers & Cargo API (Production)"

# Production MongoDB Atlas M30+ Replica Set with TLS 1.3
# Ensure IP Access List strictly permits only Production App Servers
MONGODB_URI=mongodb+srv://prod_db_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@prod-primary-cluster.mongodb.net/sai_international_production?retryWrites=true&w=majority&appName=SaiProd

# Cryptographically Secure JWT Secret (64+ character random hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_64_CHAR_HEX_SECRET_KEY_PRODUCTION_ONLY
JWT_EXPIRES_IN=7d

# Initial Super Admin (Change immediately after first boot via /admin settings)
ADMIN_EMAIL=sai.world.cc@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_20_CHAR_PRODUCTION_PASSWORD

# Strict Production CORS Allowlist (No wildcards)
CORS_ORIGIN=https://sai-international.com,https://www.sai-international.com,https://admin.sai-international.com,capacitor://localhost

# Production Redis Cluster (AWS ElastiCache / Redis Enterprise with TLS enabled)
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_AUTH_TOKEN@prod-redis.sai-internal:6379

# Production Payment Gateways (Live Mode - Requires KYC Approved Merchant Accounts)
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LIVE_WEBHOOK_SECRET

# Production AI Assistant (Google Cloud Vertex AI / Gemini API Paid Tier)
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_PAID_PRODUCTION_GEMINI_KEY

# Production Cloud CDN & Storage (ImageKit Enterprise / AWS S3)
IMAGEKIT_PUBLIC_KEY=public_REPLACE_WITH_PRODUCTION_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_REPLACE_WITH_PRODUCTION_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/sai_prod_media

# Production Transactional Email Service (SendGrid / AWS SES with SPF, DKIM, DMARC passed)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASS=SG.REPLACE_WITH_PRODUCTION_SENDGRID_API_KEY
EMAIL_FROM="Sai International Couriers & Cargo" <dispatch@sai-international.com>
ALERT_EMAIL=operations-lead@sai-international.com

# Production Google Single Sign-On
GOOGLE_CLIENT_ID=REPLACE_WITH_VERIFIED_PRODUCTION_GOOGLE_CLIENT_ID.apps.googleusercontent.com


# --- [11. Free Tier Cost Control & Service Mode Policies] ---
# Set to true only when approved paid tier subscriptions are active
ENABLE_PAID_SERVICES=false
CARRIER_MODE=sandbox
STORAGE_PROVIDER=imagekit
SMTP_PROVIDER=brevo
