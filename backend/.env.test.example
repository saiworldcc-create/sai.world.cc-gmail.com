# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - AUTOMATED TESTING (.env.test.example)
# Configuration for automated Jest, Mocha, Supertest, and QA pipeline runs.
# ==============================================================================

NODE_ENV=test
PORT=5001
APP_NAME="Sai International Couriers API (Test Suite)"

# Isolated Test Database (prevents polluting development or staging records)
MONGODB_URI=mongodb://localhost:27017/sai_international_automated_test

# Test JWT Secret
JWT_SECRET=sai_test_suite_jwt_secret_do_not_use_in_production
JWT_EXPIRES_IN=1h

# Test Admin Account
ADMIN_EMAIL=qa_admin_tester@sai.com
ADMIN_PASSWORD=TestAdminPassword@2026

CORS_ORIGIN=*
REDIS_URL=

# Mock Gateways & Sandbox Keys
RAZORPAY_KEY_ID=rzp_test_automated_qa_key
RAZORPAY_KEY_SECRET=sandbox_test_signature_qa_secret
STRIPE_SECRET_KEY=sk_test_mock_stripe_key

# Mock Integrations
GEMINI_API_KEY=mock_gemini_key
IMAGEKIT_PUBLIC_KEY=mock_public_key
IMAGEKIT_PRIVATE_KEY=mock_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mock_test

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=mock_mailtrap_user
SMTP_PASS=mock_mailtrap_pass
EMAIL_FROM="Sai Test Suite" <test@sai-couriers.com>
ALERT_EMAIL=qa_alerts@sai-couriers.com
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com

