# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - LOCAL DEVELOPMENT (.env.development.example)
# Configuration for local development on Windows / MacOS / Linux workstations.
# ==============================================================================

NODE_ENV=development
PORT=5000
APP_NAME="Sai International Couriers API (Dev)"

# Local MongoDB or Shared Development Atlas Cluster
MONGODB_URI=mongodb+srv://dev_user:dev_password@cluster0.xatyxzv.mongodb.net/sai_international_dev?retryWrites=true&w=majority

# Local Development JWT Secret (Safe for localhost testing)
JWT_SECRET=sai_dev_local_jwt_secret_key_november_2026_entropy_ok
JWT_EXPIRES_IN=7d

# Default Local Admin Seed Credentials
ADMIN_EMAIL=sai.world.cc@gmail.com
ADMIN_PASSWORD=SaiAdmin@2026

# Open CORS for Localhost Frontend (Vite) and Mobile WebViews
CORS_ORIGIN=*

# In development, Redis is optional (in-memory queue active)
REDIS_URL=

# Razorpay Test / Sandbox Keys
RAZORPAY_KEY_ID=rzp_test_demo_sandbox_key
RAZORPAY_KEY_SECRET=sandbox_dummy_secret_for_dev_mode

# Optional Developer Keys
GEMINI_API_KEY=
IMAGEKIT_PUBLIC_KEY=public_mock_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_mock_imagekit_secret
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mock_account

# Local SMTP / Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dev_test@sai.com
SMTP_PASS=
EMAIL_FROM="Sai Couriers Dev" <no-reply@sai-couriers.com>
ALERT_EMAIL=dev_admin@sai-couriers.com
GOOGLE_CLIENT_ID=


# --- [11. Free Tier Cost Control & Service Mode Policies] ---
ENABLE_PAID_SERVICES=false
CARRIER_MODE=sandbox
STORAGE_PROVIDER=imagekit
SMTP_PROVIDER=gmail
