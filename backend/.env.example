# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - BACKEND ENVIRONMENT CONFIGURATION
# Master Reference Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate with environment-specific values.
# 3. NEVER commit files containing real secrets, passwords, or keys to Git.
# ==============================================================================

# --- [1. Core Server Configuration] ---
NODE_ENV=development
PORT=5000
APP_NAME="Sai International Couriers & Cargo API"

# --- [2. Database Persistence (MongoDB Atlas or Local)] ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/sai_international?retryWrites=true&w=majority

# --- [3. Authentication & JWT Security] ---
# Generate high-entropy 64-char string for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials (used only during database initialization)
ADMIN_EMAIL=sai.world.cc@gmail.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# --- [4. Cross-Origin Resource Sharing (CORS)] ---
# Comma-separated list of allowed web origins, or * for open development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- [5. Realtime Telematics & Caching (Redis)] ---
# Optional in development (in-memory queue used if absent). Required for multi-instance production.
REDIS_URL=redis://127.0.0.1:6379

# --- [6. Payment Gateway Integrations] ---
# Razorpay Credentials (Sandbox/Test or Production Live)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Stripe Credentials (Optional / Alternative Gateway)
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourStripeWebhookSecretHere

# --- [7. Artificial Intelligence & Virtual Assistant] ---
# Google Gemini 2.5 Flash API Key (Optional: local logistics rules engine activates if absent)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- [8. Cloud Media Storage (ImageKit)] ---
# ImageKit CDN for Proof of Delivery (POD) photos, invoices, and branding assets
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- [9. Transactional Notifications & SMTP Email] ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sai.world.cc@gmail.com
SMTP_PASS=your_16_digit_google_app_password
EMAIL_FROM="Sai International Couriers & Cargo" <info@sai-couriers.com>
ALERT_EMAIL=info@sai-couriers.com

# --- [10. Single Sign-On (Google OAuth)] ---
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# --- [11. Free Tier Cost Control & Service Mode Policies] ---
# Prevent accidental charges. If false, paid APIs are blocked and zero-cost fallbacks are used.
ENABLE_PAID_SERVICES=false

# Carrier Logistics Adapter Mode: sandbox (simulated carrier data), mock (instant local records), live (carrier API)
CARRIER_MODE=sandbox

# Storage Provider: imagekit (free 20GB tier) or local (zero-cost backend filesystem storage)
STORAGE_PROVIDER=imagekit

# Transactional Email Provider: brevo (free 300/day SMTP relay), gmail (500/day), or mock (console logging)
SMTP_PROVIDER=gmail
