# ==============================================================================
# SAI INTERNATIONAL COURIERS & CARGO - STAGING / UAT (.env.staging.example)
# Configuration for staging server, pre-release testing, and client UAT.
# ==============================================================================

NODE_ENV=staging
PORT=5000
APP_NAME="Sai International Couriers API (Staging)"

# Dedicated Staging Database Cluster
MONGODB_URI=mongodb+srv://staging_user:StagingSecurePass2026@staging-cluster.mongodb.net/sai_international_staging?retryWrites=true&w=majority

# High-Entropy Staging Secret
JWT_SECRET=staging_high_entropy_jwt_secret_64_bytes_secure_string_2026
JWT_EXPIRES_IN=7d

# Staging Super Admin
ADMIN_EMAIL=staging.admin@sai-couriers.com
ADMIN_PASSWORD=StagingAdmin@2026

# Restrict CORS to Staging Domains and Mobile schemes
CORS_ORIGIN=https://staging.sai-couriers.com,https://staging-admin.sai-couriers.com,capacitor://localhost,http://localhost

# Cloud Redis (Managed ElastiCache or Redis Enterprise)
REDIS_URL=rediss://default:StagingRedisPass@staging-redis.example.com:6380

# Payment Gateways (Official Merchant Sandbox Accounts)
RAZORPAY_KEY_ID=rzp_test_StagingMerchantId
RAZORPAY_KEY_SECRET=StagingRazorpaySecretKey
STRIPE_SECRET_KEY=sk_test_StagingStripeSecretKey

# Staging AI & Storage Keys
GEMINI_API_KEY=AIzaSyStagingGeminiKeyForUatTesting
IMAGEKIT_PUBLIC_KEY=public_staging_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_staging_imagekit_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/sai_staging

# Staging Email Delivery (Verified Sandbox or SendGrid Sub-user)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.StagingApiKeyHere
EMAIL_FROM="Sai Logistics Staging" <staging-notifications@sai-couriers.com>
ALERT_EMAIL=staging-ops@sai-couriers.com
GOOGLE_CLIENT_ID=staging_google_oauth_client_id.apps.googleusercontent.com


# --- [11. Free Tier Cost Control & Service Mode Policies] ---
ENABLE_PAID_SERVICES=false
CARRIER_MODE=sandbox
STORAGE_PROVIDER=imagekit
SMTP_PROVIDER=brevo
